# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INSTAGRAM_ACCESS_TOKEN: Server-side long-lived access token for the authorised
# @nonise.florist Instagram Professional account (Instagram Graph API).
# Never expose this token in client-side code or VITE_ variables.
INSTAGRAM_ACCESS_TOKEN=""

# INSTAGRAM_USER_ID: Optional Instagram User / Business Account ID.
# Defaults to "me" for Instagram Login tokens; set to the IG Business Account ID
# when using a Meta Page / Facebook Login token.
INSTAGRAM_USER_ID=""

# INSTAGRAM_API_HOST: Optional ("instagram" default for graph.instagram.com,
# or "facebook" for graph.facebook.com).
INSTAGRAM_API_HOST="instagram"

# PAYFAST_MERCHANT_ID / PAYFAST_MERCHANT_KEY: PayFast merchant credentials.
# The key is public (it is posted in the payment form); these defaults are the
# Nonise Florist account, so only override them for a different account.
PAYFAST_MERCHANT_ID="31790723"
PAYFAST_MERCHANT_KEY="yx6v2da4vda4vdd37"

# PAYFAST_PASSPHRASE: Optional security passphrase set in the PayFast dashboard.
# Keep it server-side only; never expose it in VITE_ variables.
PAYFAST_PASSPHRASE=""

# PAYFAST_SANDBOX: Set to "true" to send payments to sandbox.payfast.co.za
# instead of the live PayFast gateway.
PAYFAST_SANDBOX="false"

# EMAIL_API_URL: Shared My Grafix notification worker used to email the
# customer and Nonise after a paid order. Defaults to the production worker.
EMAIL_API_URL="https://mygrafix-dashboard-worker.mygrafix.workers.dev"

# EMAIL_CLIENT_ID: Client row in the shared Supabase project.
EMAIL_CLIENT_ID="nonise-florist"

# ORDER_NOTIFY_SECRET: Shared secret expected by the notification worker.
# Keep it server-side only; use `wrangler secret put ORDER_NOTIFY_SECRET`
# for the Cloudflare Worker deployment.
ORDER_NOTIFY_SECRET=""
