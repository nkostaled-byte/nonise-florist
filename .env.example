# APP_URL: The public URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INSTAGRAM_ACCESS_TOKEN: Server-side long-lived access token for the authorised
# @nonise.florist Instagram Professional account (Instagram Graph API).
# Never expose this token in client-side code or VITE_ variables.
INSTAGRAM_ACCESS_TOKEN=""

# INSTAGRAM_USER_ID: Optional Instagram User / Business Account ID.
# Defaults to "me" for Instagram Login tokens; set to the IG Business Account ID
# when using a Meta Page / Facebook Login token.
INSTAGRAM_USER_ID=""

# INSTAGRAM_API_HOST: Optional ("instagram" default for graph.instagram.com,
# or "facebook" for graph.facebook.com).
INSTAGRAM_API_HOST="instagram"
